/* ── Health bar root ───────────────────────────────────────────────────── */

.health-bar-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ── Background track ──────────────────────────────────────────────────── */

.health-bar-bg {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(2, 4, 8, 0.92);
    border-radius: 5px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.82);
}

/* ── Fill ──────────────────────────────────────────────────────────────── */

.health-bar-fill {
    height: 100%;
    width: 100%;
    flex-shrink: 0;
    background-color: rgb(50, 200, 50);
    border-radius: 3px;
    transition-property: width, background-color;
    transition-duration: 0.08s;
}
